# terraform.tfvars.example
# Copy this to terraform.tfvars and adjust values.
# terraform.tfvars itself should NOT be committed if it ever holds
# anything sensitive — this .example file with placeholders is what's
# safe to keep in version control.

aws_region          = "us-east-1"
vpc_cidr            = "10.0.0.0/16"
public_subnet_cidr  = "10.0.1.0/24"
environment         = "dev"
instance_type       = "t3.micro"
bucket_name         = "replace-with-a-globally-unique-bucket-name"
